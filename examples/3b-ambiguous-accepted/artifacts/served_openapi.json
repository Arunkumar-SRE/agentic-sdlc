{
  "openapi": "3.1.0",
  "info": {
    "title": "Agentic URL Shortener",
    "description": "URL shortener with persistence, analytics and SRE hooks: health, readiness, Prometheus metrics, golden signals, rate limiting.",
    "version": "1.1.0"
  },
  "paths": {
    "/ops/golden-signals": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Golden Signals Endpoint",
        "description": "Latency, traffic, errors and saturation for this instance, with SLO status and error budgets.",
        "operationId": "golden_signals_endpoint_ops_golden_signals_get",
        "parameters": [
          {
            "name": "window",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 86400,
              "minimum": 10,
              "description": "Look-back window in seconds",
              "default": 300,
              "title": "Window"
            },
            "description": "Look-back window in seconds"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Health",
        "description": "Liveness: process is up.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Ready",
        "description": "Readiness: dependencies (database) reachable.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Prometheus Metrics",
        "operationId": "prometheus_metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/urls": {
      "post": {
        "tags": [
          "urls"
        ],
        "summary": "Create Url",
        "operationId": "create_url_api_v1_urls_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/URLCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/URLResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/urls/{short_code}/analytics": {
      "get": {
        "tags": [
          "urls"
        ],
        "summary": "Analytics",
        "operationId": "analytics_api_v1_urls__short_code__analytics_get",
        "parameters": [
          {
            "name": "short_code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Short Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/{short_code}": {
      "get": {
        "tags": [
          "urls"
        ],
        "summary": "Redirect",
        "operationId": "redirect__short_code__get",
        "parameters": [
          {
            "name": "short_code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Short Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyticsResponse": {
        "properties": {
          "short_code": {
            "type": "string",
            "title": "Short Code"
          },
          "long_url": {
            "type": "string",
            "title": "Long Url"
          },
          "total_clicks": {
            "type": "integer",
            "title": "Total Clicks"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "last_accessed": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Accessed"
          },
          "recent_clicks": {
            "items": {
              "$ref": "#/components/schemas/ClickEvent"
            },
            "type": "array",
            "title": "Recent Clicks",
            "default": []
          },
          "clicks_by_day": {
            "items": {
              "$ref": "#/components/schemas/DayCount"
            },
            "type": "array",
            "title": "Clicks By Day",
            "default": []
          },
          "top_referrers": {
            "items": {
              "$ref": "#/components/schemas/ReferrerCount"
            },
            "type": "array",
            "title": "Top Referrers",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "short_code",
          "long_url",
          "total_clicks",
          "created_at"
        ],
        "title": "AnalyticsResponse"
      },
      "ClickEvent": {
        "properties": {
          "clicked_at": {
            "type": "string",
            "format": "date-time",
            "title": "Clicked At"
          },
          "referrer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Referrer"
          },
          "user_agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Agent"
          }
        },
        "type": "object",
        "required": [
          "clicked_at"
        ],
        "title": "ClickEvent"
      },
      "DayCount": {
        "properties": {
          "day": {
            "type": "string",
            "title": "Day"
          },
          "clicks": {
            "type": "integer",
            "title": "Clicks"
          }
        },
        "type": "object",
        "required": [
          "day",
          "clicks"
        ],
        "title": "DayCount"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ReferrerCount": {
        "properties": {
          "referrer": {
            "type": "string",
            "title": "Referrer"
          },
          "clicks": {
            "type": "integer",
            "title": "Clicks"
          }
        },
        "type": "object",
        "required": [
          "referrer",
          "clicks"
        ],
        "title": "ReferrerCount"
      },
      "URLCreate": {
        "properties": {
          "long_url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Long Url"
          },
          "custom_alias": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 16,
                "minLength": 3,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Alias"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At",
            "description": "ISO-8601; must be in the future. Naive values are treated as UTC."
          }
        },
        "type": "object",
        "required": [
          "long_url"
        ],
        "title": "URLCreate"
      },
      "URLResponse": {
        "properties": {
          "short_code": {
            "type": "string",
            "title": "Short Code"
          },
          "short_url": {
            "type": "string",
            "title": "Short Url"
          },
          "long_url": {
            "type": "string",
            "title": "Long Url"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "short_code",
          "short_url",
          "long_url",
          "created_at"
        ],
        "title": "URLResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}